# McFuntain — environment variables
# Copy to .env.local for local dev; set the same keys in the Vercel project
# (Production) for the live site. Never commit real values.

# --- Sanity CMS (already in use) -------------------------------------------
# Viewer read token so the live site can read Studio edits.
SANITY_API_READ_TOKEN=

# --- Product manuals: signed download links --------------------------------
# Secret used to HMAC-sign /api/manuals/<slug> links. Any long random string.
# If unset, a public dev fallback is used (NOT secure — set this in production).
MCFUNTAIN_PDF_SIGNING_KEY=

# --- Private owner vault (/mcfuntain-private-product-vault) -----------------
# The owner passphrase for the vault gate. REQUIRED in production: if unset,
# the vault is locked to everyone (fail-closed). Pick a strong passphrase.
MCFUNTAIN_LIBRARY_KEY=

# --- Transactional email (optional until you wire it) ----------------------
# Resend API key. While unset, the "Email Me This Manual", prospect-send, and
# order-confirmation flows return an honest "not enabled yet" — nothing breaks.
RESEND_API_KEY=
# Verified sender address shown on outgoing email.
MCFUNTAIN_FROM_EMAIL=McFuntain Nutraceuticals <support@mcfuntain.com>

# --- Auto-delivery on purchase (optional, for later Stripe wiring) ---------
# Shared secret the payment webhook sends in the x-mcfuntain-hook-secret header
# when POSTing a paid order to /api/order-delivery. Unset = endpoint disabled.
MCFUNTAIN_ORDER_HOOK_SECRET=

# --- Site origin (used to build absolute links in emails) ------------------
NEXT_PUBLIC_SITE_URL=https://www.mcfuntain.com
